# AURA environment configuration. Copy to .env and edit as needed.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fitness_db
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# Ingestion service (Node.js)
INGEST_PORT=4000
# Connection string used by Node.js ingestion
DATABASE_URL=mysql://root:change_me@localhost:3306/fitness_db
VEHICLE_ID=EV-AURA-001

# FastAPI ML backend
API_PORT=8000
# Same DB, used by Python services
PY_DATABASE_URL=mysql://root:change_me@localhost:3306/fitness_db

# Simulator
SIM_INTERVAL_MS=1000
SIM_VEHICLE_ID=EV-AURA-001
INGEST_URL=http://localhost:4000

# Web UI (Vite). Get a free token at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE
VITE_MAP_STYLE=mapbox://styles/mapbox/dark-v11
VITE_INGEST_URL=http://localhost:4000
VITE_API_URL=http://localhost:8000
